    AFRAME.registerComponent('position-clamp', {
      tick: function () {
        const p = this.el.getAttribute('position');
        p.x = Math.max(-8.0, Math.min(4.0, p.x));
        p.z = Math.max(-14.0, Math.min(-6.0, p.z));
        this.el.setAttribute('position', p);
      }
    });

    AFRAME.registerComponent('npc-controller', {
      init: function () {
        this.mixer = null;
        this.actions = [];
        this.el.addEventListener('model-loaded', () => {
          const model = this.el.getObject3D('mesh');
          if (!model) return;
          model.scale.set(1.5, 1.5, 1.5);
          if (model.animations && model.animations.length > 0) {
            this.mixer = new THREE.AnimationMixer(model);
            this.actions = model.animations.map(clip => {
              const action = this.mixer.clipAction(clip);
              action.loop = THREE.LoopRepeat;
              action.play();
              return action;
            });
          }
        });
      },
      tick: function (t, dt) {
        if (this.mixer) this.mixer.update(dt / 1000);
      },
      stopAnimations: function () {
        this.actions.forEach(a => a.stop());
        this.actions = [];
        this.mixer = null;
      }
    });

    AFRAME.registerComponent('thumbstick-locomotion', {
      init: function () {
        this.moveX = 0;
        this.moveZ = 0;
        this.rotateY = 0;
        this.deadZone = 0.15;
        this.speed = 0.05;
        this.keys = { w: false, a: false, s: false, d: false };

        const leftEl = document.getElementById('leftController');
        if (leftEl) {
          leftEl.addEventListener('axismove', (e) => {
            const ax = e.detail.axis;
            if (ax) {
              this.moveX = Math.abs(ax[0]) > this.deadZone ? ax[0] : 0;
              this.moveZ = Math.abs(ax[1]) > this.deadZone ? ax[1] : 0;
            }
          });
        }
        const rightEl = document.getElementById('rightController');
        if (rightEl) {
          rightEl.addEventListener('axismove', (e) => {
            const ax = e.detail.axis;
            if (ax) {
              this.rotateY = Math.abs(ax[0]) > this.deadZone ? ax[0] : 0;
            }
          });
        }

        window.addEventListener('keydown', (e) => {
          const k = e.key.toLowerCase();
          if (k in this.keys) { this.keys[k] = true; e.preventDefault(); }
        });
        window.addEventListener('keyup', (e) => {
          const k = e.key.toLowerCase();
          if (k in this.keys) { this.keys[k] = false; e.preventDefault(); }
        });

        window.addEventListener('keydown', (e) => {
          if (e.key.toLowerCase() === 'p') {
            const pos = this.el.getAttribute('position');
            const rot = this.el.getAttribute('rotation');
            console.log('RIG:', pos.x.toFixed(2), pos.y.toFixed(2), pos.z.toFixed(2), 'ROT:', rot.y.toFixed(1));
          }
        });
      },
      tick: function () {
        if (this.rotateY !== 0) {
          const r = this.el.getAttribute('rotation') || { x: 0, y: 0, z: 0 };
          r.y -= this.rotateY * 1.5;
          this.el.setAttribute('rotation', r);
        }

        let kx = 0, kz = 0;
        if (this.keys.w) kz += 1;
        if (this.keys.s) kz -= 1;
        if (this.keys.a) kx -= 1;
        if (this.keys.d) kx += 1;

        const mx = this.moveX + kx;
        const mz = this.moveZ + kz;

        if (mx !== 0 || mz !== 0) {
          const cam = document.getElementById('camera');
          if (cam) {
            const rigRot = this.el.getAttribute('rotation') || { x: 0, y: 0, z: 0 };
            const camRot = cam.getAttribute('rotation') || { x: 0, y: 0, z: 0 };
            const yaw = THREE.MathUtils.degToRad((rigRot.y || 0) + (camRot.y || 0));
            const s = Math.sin(yaw), c = Math.cos(yaw);
            const p = this.el.getAttribute('position');
            p.x += (mx * c - mz * s) * this.speed;
            p.z += (-mx * s - mz * c) * this.speed;
            this.el.setAttribute('position', p);
          }
        }
      }
    });

