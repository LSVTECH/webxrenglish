// Cross-browser SpeechRecognition detection with fallbacks
class PicoAudioRecorder {
  constructor() {
    this.mediaRecorder = null;
    this.audioChunks = [];
    this.stream = null;
  }
  async start() {
    this.audioChunks = [];
    let stream = window.globalMicStream;
    if (!stream) {
      stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      window.globalMicStream = stream;
    }
    this.stream = stream;
    let options = {};
    if (MediaRecorder.isTypeSupported('audio/webm;codecs=opus')) {
      options.mimeType = 'audio/webm;codecs=opus';
    } else if (MediaRecorder.isTypeSupported('audio/webm')) {
      options.mimeType = 'audio/webm';
    }
    this.mediaRecorder = new MediaRecorder(this.stream, options);
    this.mediaRecorder.ondataavailable = (event) => {
      if (event.data && event.data.size > 0) {
        this.audioChunks.push(event.data);
      }
    };
    this.mediaRecorder.start();
  }
  async stop() {
    return new Promise((resolve) => {
      if (!this.mediaRecorder || this.mediaRecorder.state === 'inactive') {
        resolve(null);
        return;
      }
      this.mediaRecorder.onstop = () => {
        const audioBlob = new Blob(this.audioChunks, { type: this.mediaRecorder.mimeType });
        const reader = new FileReader();
        reader.onloadend = () => {
          const base64data = reader.result.split(',')[1];
          resolve(base64data);
        };
        reader.readAsDataURL(audioBlob);
      };
      this.mediaRecorder.stop();
    });
  }
}
const picoRecorder = new PicoAudioRecorder();
function detectBrowser() {
  const ua = navigator.userAgent.toLowerCase();
  if (ua.includes('pico') || ua.includes('picovr')) return 'pico';
  if (ua.includes('firefox')) return 'firefox';
  if (ua.includes('samsungbrowser')) return 'samsung';
  if (ua.includes('edg/') || ua.includes('edge/')) return 'edge';
  if (ua.includes('opr/') || ua.includes('opera')) return 'opera';
  if (ua.includes('chrome') || ua.includes('chromium')) return 'chrome';
  if (ua.includes('safari')) return 'safari';
  return 'unknown';
}
const SpeechRecognition = window.SpeechRecognition 
                        || window.webkitSpeechRecognition 
                        || window.mozSpeechRecognition 
                        || window.msSpeechRecognition;
let usePicoRecorder = (!SpeechRecognition || detectBrowser() === 'pico');
let recognition = null;

// Initialize SpeechRecognition if supported
function initializeSpeechRecognition() {
  if (!SpeechRecognition) {
    return false;
  }
  
  try {
    recognition = new SpeechRecognition();
    recognition.continuous = false;
    recognition.interimResults = true; // Real-time feedback! Shows text on the fly
    recognition.lang = currentLang;
    
    // Realtime intermediate results
    recognition.onresult = (event) => {
      let interimTranscript = '';
      let finalTranscript = '';

      for (let i = event.resultIndex; i < event.results.length; ++i) {
        if (event.results[i].isFinal) {
          finalTranscript += event.results[i][0].transcript;
        } else {
          interimTranscript += event.results[i][0].transcript;
        }
      }

      const transcriptText = finalTranscript || interimTranscript;
      if (transcriptText) {
        recognizedText = transcriptText;
        document.getElementById('userText').setAttribute('value', `You: "${recognizedText}"`);
      }
    };

    recognition.onstart = () => {
      recognitionStarted = true;
    };

    recognition.onerror = (event) => {
      console.error("Speech Recognition Event Error:", event.error);
      if (event.error === 'not-allowed') {
        updateUIState("Err: Mic Blocked");
        showMicWarning("Mic access was denied. Please allow microphone permissions in the browser settings and refresh.");
      } else if (event.error === 'no-speech') {
        // Silent skip
      } else {
        updateUIState("Err: " + event.error);
      }
      setCubeState("idle");
    };

    recognition.onend = () => {
      console.log("Recognition lifecycle complete. recognizedText:", recognizedText);
      clearTimeout(recognitionFallbackTimeout);
      isRecording = false;
      recognitionStarted = false;

      // Reset button visual state
      const talkBtn = document.getElementById('talkButton');
      if (talkBtn) {
        talkBtn.classList.remove('listening');
        talkBtn.textContent = 'Hold to Speak';
      }

      if (recognizedText) {
        updateUIState("Thinking...");
        setCubeState("thinking");
        sendToGemini(recognizedText);
      } else {
        updateUIState("HOLD M TO SPEAK");
        setCubeState("idle");
        document.getElementById('userText').setAttribute('value', 'You: ...');
      }
    };
    
    return true;
  } catch (err) {
    console.error("Failed to initialize SpeechRecognition:", err);
    showMicWarning("Failed to initialize speech recognition. Please try refreshing the page.");
    return false;
  }
}
