    // ==========================================
    // RECORDING CONTROL FLOW
    // ==========================================
async function startRecording() {
  if (!recognition && !usePicoRecorder) {
    showTextInputFallback();
    return;
  }
  if (isRecording) return;
  const browser = detectBrowser();
  const hasPermission = await requestMicPermissionIfNeeded();
  if (!hasPermission) {
    showTextInputFallback();
    return;
  }
  initAmbientAudio();
  if (!ttsAudioCtx) {
    ttsAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
  }
  if (ttsAudioCtx.state === 'suspended') {
    ttsAudioCtx.resume();
  }
  const talkBtn = document.getElementById('talkButton');
  if (talkBtn) {
    talkBtn.classList.add('listening');
    talkBtn.textContent = usePicoRecorder ? 'Hold to Speak (Recording...)' : 'Hold to Speak (Listening...)';
  }
  recognizedText = "";
  stopSpeakingAnimation();
  const cubeEl = document.getElementById('aiNPC');
  if (cubeEl) {
    cubeEl.removeAttribute('animation__move_room');
    cubeEl.setAttribute('position', '-8.52 0.05 -8.93');
    cubeEl.setAttribute('rotation', '0 270 0');
  }
  isRecording = true;
  updateUIState("Listening...");
  setCubeState("listening");
  document.getElementById('userText').setAttribute('value', "You: [Listening...]");
  if (usePicoRecorder) {
    try {
      await picoRecorder.start();
    } catch (err) {
      console.error(err);
      isRecording = false;
      updateUIState("HOLD M TO SPEAK");
      setCubeState("idle");
      showTextInputFallback();
    }
  } else {
    recognitionStarted = false;
    try {
      recognition.lang = currentLang;
      recognition.start();
    } catch (err) {
      console.error(err);
      isRecording = false;
      updateUIState("HOLD M TO SPEAK");
      setCubeState("idle");
    }
  }
}

async function stopRecording() {
  if (!isRecording) return;
  if (usePicoRecorder) {
    isRecording = false;
    updateUIState("Transcribing...");
    document.getElementById('userText').setAttribute('value', "You: [Transcribing...]");
    const talkBtn = document.getElementById('talkButton');
    if (talkBtn) {
      talkBtn.classList.remove('listening');
      talkBtn.textContent = 'Hold to Speak';
    }
    try {
      const base64Audio = await picoRecorder.stop();
      if (base64Audio) {
        const res = await fetch('/api/transcribe', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            audio: {
              content: base64Audio
            }
          })
        });
        if (res.ok) {
          const data = await res.json();
          recognizedText = data.transcript || '';
        }
      }
    } catch (err) {
      console.error(err);
    }
    if (recognizedText) {
      updateUIState("Thinking...");
      setCubeState("thinking");
      sendToGemini(recognizedText);
    } else {
      updateUIState("HOLD M TO SPEAK");
      setCubeState("idle");
      document.getElementById('userText').setAttribute('value', 'You: ...');
    }
  } else {
    if (!recognition) return;
    if (!recognitionStarted) {
      isRecording = false;
      return;
    }
    try {
      recognition.stop();
    } catch (err) {
      console.error(err);
    }
    clearTimeout(recognitionFallbackTimeout);
    recognitionFallbackTimeout = setTimeout(() => {
      if (isRecording) {
        recognition.onend();
      }
    }, 3000);
  }
}

