  if (!banner || !btn) return;
  banner.classList.add('visible');
  checkMicPermissionState().then(state => {
    if (state === 'granted') {
      btn.textContent = '✓ Microphone Enabled';
      btn.classList.add('granted');
      btn.disabled = true;
    } else if (state === 'denied') {
      btn.textContent = '❌ Mic Blocked';
      showPicoMicFailureHelp();
    }
  });
  btn.addEventListener('click', async () => {
    if (window.globalMicStream) return;
    btn.textContent = 'Requesting...';
    btn.disabled = true;
    const granted = await requestMicPermissionIfNeeded();
    if (granted) {
      btn.textContent = '✓ Microphone Enabled';
      btn.classList.add('granted');
      btn.disabled = true;
    } else {
      btn.textContent = '🎤 Try Again';
      btn.disabled = false;
    }
  });
}

  // Function to request microphone permission when needed (not on page load)
  async function requestMicPermissionIfNeeded() {
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      showMicWarning("Your browser does not support microphone access. Please use a modern browser like Chrome, Firefox, or Safari.");
      showTextInputFallback();
      return false;
    }
    if (window.globalMicStream) {
      return true;
    }
    try {
      const constraints = getAudioConstraints();
      const timeout = new Promise((_, reject) => setTimeout(() => reject(new Error('timeout')), 8000));
      const stream = await Promise.race([
        navigator.mediaDevices.getUserMedia(constraints),
        timeout
      ]);
      window.globalMicStream = stream;
      console.log("Microphone permission verified.");
      return true;
    } catch (err) {
      console.warn("Microphone access failed:", err);
      if (detectBrowser() === 'pico') {
        showPicoMicFailureHelp();
      } else if (err.message === 'timeout') {
        showMicWarning("Microphone access timed out. Check your microphone and try again.");
      } else {
        showMicWarning("Microphone access denied. Please allow microphone permissions in your browser settings and refresh.");
      }
      showTextInputFallback();
      return false;
    }
  }

