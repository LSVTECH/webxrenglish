      if (roomDetails2D) roomDetails2D.textContent = obtainedValues.roomType;
      if (nights2D) nights2D.textContent = obtainedValues.nights;
      if (bookingStatus2D) {
        bookingStatus2D.textContent = obtainedValues.roomNumberAssigned;
        bookingStatus2D.style.color = (obtainedValues.roomNumberAssigned !== "TBD") ? "#8aaa88" : "#c8b88a";
      }
      
      if (hudTip) {
        if (!missions.greeted) {
          hudTip.textContent = "Tip: Welcome the guest! Try saying 'Hello, welcome to our hotel.'";
        } else if (!missions.nameObtained) {
          hudTip.textContent = "Tip: Ask for the guest's name. Try 'Could I have your name, please?'";
        } else if (!missions.guestsConfirmed) {
          hudTip.textContent = "Tip: Ask how many people are staying. Try 'For how many people is the room?'";
        } else if (!missions.roomTypeSelected) {
          hudTip.textContent = "Tip: Offer room types and ask which one they'd prefer. Try 'We have single rooms, double rooms, and suites. Which would you like?'";
        } else if (!missions.nightsCountAsked) {
          hudTip.textContent = "Tip: Ask how many nights they will stay. Try 'How many nights will you be staying with us?'";
        } else if (!missions.bookingConfirmed) {
          hudTip.textContent = "Tip: Assign a room number and confirm the booking! Try 'I have assigned you Room 204. Your booking is confirmed!'";
        } else {
          hudTip.textContent = "Congratulations! You have completed all checklist items. Waiting for evaluation results...";
        }
      }
    }

    // ==========================================
    // FINAL EVALUATION SYSTEM
    // ==========================================
    async function triggerEvaluation() {
      if (evaluationComplete) return;
      evaluationComplete = true;

      updateUIState("EVALUATING...");
      setCubeState("thinking");

      try {
        const evalPrompt = `You are an expert hospitality instructor. Evaluate the receptionist's performance in the preceding hotel booking conversation.

Analyze the entire conversation history. Rate the receptionist 1-10 for each criterion:
1. Communication - clear, polite, appropriate vocabulary
2. LogicalOrder - proper sequence: greeting → details → assigning room → confirmation
3. Professionalism - courteous, helpful, service attitude
4. Precision - successfully gathered all required information
5. Fluency - smooth natural interaction

Provide evaluation in this JSON schema:
{
  "communication": number,
  "logicalOrder": number,
  "professionalism": number,
  "precision": number,
  "fluency": number,
  "overallScore": number,
  "summary": "Brief summary of overall performance.",
  "mistakes": "Specific mistakes or areas needing improvement.",
  "recommendations": "Actionable recommendations to improve."
}

Be honest but constructive. Use numbers only for scores (1-10).`;

        const evalPayload = {
          contents: chatHistory,
          systemInstruction: {
            parts: [{ text: evalPrompt }]
          },
          generationConfig: {
            responseMimeType: "application/json"
          }
        };

        const response = await fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(evalPayload)
        });

        if (!response.ok) {
          throw new Error(`Evaluation API failed: ${response.status}`);
        }

        const data = await response.json();
        let evalString = "";
        if (data.candidates && data.candidates[0] && data.candidates[0].content && data.candidates[0].content.parts[0]) {
          evalString = data.candidates[0].content.parts[0].text;
        }

        let evalData;
        try {
          evalData = JSON.parse(evalString);
        } catch {
          const cleaned = evalString.replace(/```json|```/g, "").trim();
          evalData = JSON.parse(cleaned);
        }

        // Update VR 3D Evaluation Panel
        updateEvaluationUI(evalData);

        // Update 2D HUD Evaluation
        updateEvaluationHUD(evalData);

        updateUIState("EVALUATION COMPLETE");
        setCubeState("idle");

      } catch (error) {
        console.error("Evaluation failed:", error);
        updateUIState("HOLD M TO SPEAK");
        setCubeState("idle");
        evaluationComplete = false;
      }
    }

    function updateEvaluationUI(evalData) {
      const evalPanel = document.getElementById('evaluationPanel');
      if (!evalPanel) return;

      evalPanel.setAttribute('visible', 'true');

      const evalScore = document.getElementById('evalScore');
      if (evalScore) {
        evalScore.setAttribute('value', `OVERALL: ${evalData.overallScore || '?'}/10`);
      }

      const evalCriteria1 = document.getElementById('evalCriteria1');
      if (evalCriteria1) {
        evalCriteria1.setAttribute('value', `Communication: ${evalData.communication || '-'}/10\nLogical Order: ${evalData.logicalOrder || '-'}/10\nProfessionalism: ${evalData.professionalism || '-'}/10`);
      }

      const evalCriteria2 = document.getElementById('evalCriteria2');
      if (evalCriteria2) {
        evalCriteria2.setAttribute('value', `Precision: ${evalData.precision || '-'}/10\nFluency: ${evalData.fluency || '-'}/10`);
      }

      const evalSummary = document.getElementById('evalSummary');
      if (evalSummary) {
        evalSummary.setAttribute('value', `Summary: ${evalData.summary || 'No summary provided.'}`);
      }

      const evalMistakes = document.getElementById('evalMistakes');
      if (evalMistakes) {
        evalMistakes.setAttribute('value', `Mistakes: ${evalData.mistakes || 'None recorded'}`);
      }

      const evalRecommendations = document.getElementById('evalRecommendations');
      if (evalRecommendations) {
        evalRecommendations.setAttribute('value', `Recommendations: ${evalData.recommendations || 'Continue practicing!'}`);
      }

      // Hide dialogue panel, show evaluation panel
      const uiPanel = document.getElementById('uiPanel');
      if (uiPanel) uiPanel.setAttribute('visible', 'false');
    }

    function updateEvaluationHUD(evalData) {
      const hudTip = document.getElementById('hudTip');
      if (hudTip) {
        hudTip.innerHTML = `<strong>EVALUATION COMPLETE</strong><br>Overall: ${evalData.overallScore || '?'}/10<br>Communication: ${evalData.communication || '-'}/10 | Logical Order: ${evalData.logicalOrder || '-'}/10 | Professionalism: ${evalData.professionalism || '-'}/10<br>Precision: ${evalData.precision || '-'}/10 | Fluency: ${evalData.fluency || '-'}/10<br><br>Summary: ${evalData.summary || ''}<br>Mistakes: ${evalData.mistakes || 'None recorded'}<br>Recommendations: ${evalData.recommendations || 'Continue practicing!'}`;
      }

      // Show reset button
      let resetBtn = document.getElementById('resetSimulationBtn');
      if (!resetBtn) {
        resetBtn = document.createElement('button');
        resetBtn.id = 'resetSimulationBtn';
