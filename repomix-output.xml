    function setCubeState(state) {
      const light = document.getElementById('cubeLight');
      if (!light) return;

      switch (state) {
        case "idle":
          light.setAttribute('light', 'color: #c8b88a; intensity: 1.2; distance: 6');
          stopSpeakingAnimation();
          break;

        case "listening":
          light.setAttribute('light', 'color: #d4ccc0; intensity: 1.5; distance: 6');
          stopSpeakingAnimation();
          break;

        case "thinking":
          light.setAttribute('light', 'color: #d4ccc0; intensity: 1.5; distance: 6');
          stopSpeakingAnimation();
          break;

        case "speaking":
          light.setAttribute('light', 'color: #d4ccc0; intensity: 1.5; distance: 6');
          startSpeakingAnimation();
          break;
      }
    }

    function startSpeakingAnimation() {
      stopSpeakingAnimation();
      const light = document.getElementById('cubeLight');
      if (!light) return;
      let dir = 1;
      let intensity = 1.2;
      speechAnimationInterval = setInterval(() => {
        intensity += 0.08 * dir;
        if (intensity >= 2.0) dir = -1;
        else if (intensity <= 1.0) dir = 1;
        light.setAttribute('light', `color: #d4ccc0; intensity: ${intensity}; distance: 8`);
      }, 80);
    }

    function stopSpeakingAnimation() {
      if (speechAnimationInterval) {
        clearInterval(speechAnimationInterval);
        speechAnimationInterval = null;
      }
      const light = document.getElementById('cubeLight');
      if (light) {
        light.setAttribute('light', 'color: #c8b88a; intensity: 1.2; distance: 8');
      }
    }

