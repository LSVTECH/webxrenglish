        .then((stream) => {
          console.log("Microphone permission verified.");
          stream.getTracks().forEach(track => track.stop()); // close immediately to free resources
        })
        .catch((err) => {
          console.warn("Microphone access permission prompt failed or denied:", err);
          showMicWarning("Microphone access is blocked. Click the microphone/lock icon next to the address bar, allow permissions, and refresh.");
        });
    }

    if (SpeechRecognition) {
      recognition = new SpeechRecognition();
      recognition.continuous = false;
      recognition.interimResults = true; // Real-time feedback! Shows text on the fly
      recognition.lang = currentLang;

      // Realtime intermediate results
      recognition.onresult = (event) => {
        let interimTranscript = '';
        let finalTranscript = '';

        for (let i = event.resultIndex; i < event.results.length; ++i) {
          if (event.results[i].isFinal) {
            finalTranscript += event.results[i][0].transcript;
          } else {
            interimTranscript += event.results[i][0].transcript;
          }
        }

        const transcriptText = finalTranscript || interimTranscript;
        if (transcriptText) {
          recognizedText = transcriptText;
          document.getElementById('userText').setAttribute('value', `You: "${recognizedText}"`);
        }
      };

      recognition.onstart = () => {
        recognitionStarted = true;
      };

      recognition.onerror = (event) => {
        console.error("Speech Recognition Event Error:", event.error);
        if (event.error === 'not-allowed') {
          updateUIState("Err: Mic Blocked");
          showMicWarning("Mic access was denied. Please allow microphone permissions in the browser settings and refresh.");
        } else if (event.error === 'no-speech') {
          // Silent skip
        } else {
          updateUIState("Err: " + event.error);
        }
        setCubeState("idle");
      };

      recognition.onend = () => {
        console.log("Recognition lifecycle complete. recognizedText:", recognizedText);
        clearTimeout(recognitionFallbackTimeout);
        isRecording = false;
        recognitionStarted = false;

        // Reset button visual state
        const talkBtn = document.getElementById('talkButton');
        if (talkBtn) {
          talkBtn.classList.remove('listening');
          talkBtn.textContent = 'Hold to Speak';
        }

        if (recognizedText) {
          updateUIState("Thinking...");
          setCubeState("thinking");
          sendToGemini(recognizedText);
        } else {
          updateUIState("HOLD M TO SPEAK");
          setCubeState("idle");
          document.getElementById('userText').setAttribute('value', 'You: ...');
        }
      };
    } else {
      console.warn("SpeechRecognition not supported in this browser.");
      showMicWarning("Speech recognition is NOT supported in this browser. Please open this page in Chrome or Edge over localhost or HTTPS.");
    }

    // ==========================================
    // INITIALIZATION & USER INPUTS
    // ==========================================
    document.addEventListener('DOMContentLoaded', () => {
      const scene = document.querySelector('a-scene');
      if (scene.hasLoaded) {
        initApp();
      } else {
        scene.addEventListener('loaded', initApp);
      }
    });

    function initApp() {
      console.log("App ready.");
      
      setCubeState("idle");
      updateUIState("HOLD M TO SPEAK");

      // A. Keyboard Hook
      window.addEventListener('keydown', (e) => {
        if (e.key.toLowerCase() === 'm' && !isRecording) {
          startRecording();
        }
      });

      window.addEventListener('keyup', (e) => {
        if (e.key.toLowerCase() === 'm' && isRecording) {
          stopRecording();
        }
      });

      // B. 2D Button Hook (Desktop/Mobile overlay)
      const talkBtn = document.getElementById('talkButton');
      if (talkBtn) {
        talkBtn.addEventListener('mousedown', startRecording);
        talkBtn.addEventListener('mouseup', stopRecording);
        talkBtn.addEventListener('mouseleave', stopRecording);
        
        // Touch supports
        talkBtn.addEventListener('touchstart', (e) => {
          e.preventDefault();
          startRecording();
        });
        talkBtn.addEventListener('touchend', (e) => {
          e.preventDefault();
          stopRecording();
        });
      }

      // C. Click on AI Cube Hook (Toggles voice)
      const cubeEl = document.getElementById('aiCube');
      if (cubeEl) {
        cubeEl.addEventListener('click', () => {
          if (isRecording) {
            stopRecording();
          } else {
            startRecording();
          }
        });
      }

      // D. VR Controller Trigger Hooks
      const bindControllerEvents = (controllerId) => {
        const controllerEl = document.getElementById(controllerId);
        if (!controllerEl) return;

        controllerEl.addEventListener('triggerdown', () => {
          console.log(`VR Controller Trigger start: ${controllerId}`);
          startRecording();
        });

        controllerEl.addEventListener('triggerup', () => {
          console.log(`VR Controller Trigger stop: ${controllerId}`);
          stopRecording();
        });
      };

      bindControllerEvents('leftController');
      bindControllerEvents('rightController');

      // E. Clean up desktop camera cursor when entering VR mode
      const sceneEl = document.querySelector('a-scene');
      sceneEl.addEventListener('enter-vr', () => {
        const cursor = document.getElementById('desktopCursor');
        if (cursor) cursor.setAttribute('visible', 'false');
      });
      sceneEl.addEventListener('exit-vr', () => {
        const cursor = document.getElementById('desktopCursor');
        if (cursor) cursor.setAttribute('visible', 'true');
      });

      // Unlock Audio Context on chrome on first user click - removed to avoid WebSocket voice extraction error
    }

    // ==========================================
    // RECORDING CONTROL FLOW
    // ==========================================
    function startRecording() {
      if (!recognition) return;
      if (isRecording) return;

      // Update UI button visual state
      const talkBtn = document.getElementById('talkButton');
      if (talkBtn) {
        talkBtn.classList.add('listening');
        talkBtn.textContent = 'Hold to Speak (Listening…)';
      }

      // Reset text
      recognizedText = "";

      // Interrupt TTS
      if (window.speechSynthesis) {
        window.speechSynthesis.cancel();
      }
      stopSpeakingAnimation();

      // Reset cube position and restore bob animation if it flew away
      const cubeEl = document.getElementById('aiCube');
      if (cubeEl) {
        cubeEl.removeAttribute('animation__move_room');
        cubeEl.setAttribute('position', '0 1.8 -1.5');
        if (!cubeEl.hasAttribute('animation__bob')) {
          cubeEl.setAttribute('animation__bob', 'property: position; to: 0 1.95 -1.5; dir: alternate; dur: 2200; loop: true; easing: easeInOutSine');
        }
      }

      isRecording = true;
      updateUIState("Listening...");
      setCubeState("listening");
      document.getElementById('userText').setAttribute('value', "You: [Listening...]");
      
      recognitionStarted = false;
      try {
        recognition.lang = currentLang;
        recognition.start();
      } catch (err) {
        console.error("Failed to start speech recognition:", err);
      }
    }

    function stopRecording() {
      if (!isRecording || !recognition) return;
      if (!recognitionStarted) {
        isRecording = false;
        return;
      }
      
      try {
        recognition.stop();
      } catch (err) {
        console.error("Failed to stop speech recognition:", err);
      }

      // Safety fallback: VR browsers sometimes fail to fire the onend event.
      clearTimeout(recognitionFallbackTimeout);
      recognitionFallbackTimeout = setTimeout(() => {
        if (isRecording) {
          console.warn("Safety fallback: onend did not fire. Forcing reset.");
          recognition.onend();
        }
      }, 3000);
    }

    // ==========================================
    // DYNAMIC VISUAL STATES & ANIMATIONS
    // ==========================================
    function updateUIState(stateText) {
      // 3D VR text
      const status3D = document.getElementById('statusText');
      if (status3D) {
        status3D.setAttribute('value', stateText.toUpperCase());
        
        if (stateText === "Listening...") status3D.setAttribute('color', '#22d3ee');
        else if (stateText === "Thinking...") status3D.setAttribute('color', '#fbbf24');
        else if (stateText === "Speaking...") status3D.setAttribute('color', '#f472b6');
        else status3D.setAttribute('color', '#38bdf8');
      }

      // 2D Desktop badge
      const badge2D = document.getElementById('hudStatusBadge');
      if (badge2D) {
        badge2D.textContent = stateText;
        badge2D.className = 'status-badge'; // reset
        if (stateText === "Listening...") badge2D.classList.add('listening');
        if (stateText === "Thinking...") badge2D.classList.add('thinking');
        if (stateText === "Speaking...") badge2D.classList.add('speaking');
      }
    }

    function setCubeState(state) {
      const cube = document.getElementById('aiCube');
      const light = document.getElementById('cubeLight');
      if (!cube || !light) return;

      switch (state) {
        case "idle":
          cube.setAttribute('material', 'color: #6366f1; emissive: #312e81; emissiveIntensity: 1.2; roughness: 0.05; metalness: 0.95');
          light.setAttribute('light', 'color: #818cf8; intensity: 1.5; distance: 6');
          cube.setAttribute('animation__rotate', 'property: rotation; to: 360 405 45; dur: 9000; loop: true; easing: linear');
          stopSpeakingAnimation();
          break;

        case "listening":
          cube.setAttribute('material', 'color: #22d3ee; emissive: #0891b2; emissiveIntensity: 2.0; roughness: 0.1; metalness: 0.8');
          light.setAttribute('light', 'color: #22d3ee; intensity: 2.2; distance: 7');
          cube.setAttribute('animation__rotate', 'property: rotation; to: 360 405 45; dur: 4500; loop: true; easing: linear');
          stopSpeakingAnimation();
          break;

        case "thinking":
          cube.setAttribute('material', 'color: #fbbf24; emissive: #b45309; emissiveIntensity: 2.5; roughness: 0.15; metalness: 0.8');
          light.setAttribute('light', 'color: #fbbf24; intensity: 2.5; distance: 7');
          cube.setAttribute('animation__rotate', 'property: rotation; to: 720 405 45; dur: 2200; loop: true; easing: linear');
          stopSpeakingAnimation();
          break;

        case "speaking":
          cube.setAttribute('material', 'color: #ec4899; emissive: #db2777; emissiveIntensity: 2.2; roughness: 0.05; metalness: 0.9');
          light.setAttribute('light', 'color: #f472b6; intensity: 2.0; distance: 8');
          cube.setAttribute('animation__rotate', 'property: rotation; to: 360 405 45; dur: 6000; loop: true; easing: linear');
          startSpeakingAnimation();
          break;
      }
    }

    function startSpeakingAnimation() {
      stopSpeakingAnimation();
      const cube = document.getElementById('aiCube');
      if (!cube) return;

      let direction = 1;
      let scale = 1.0;
      speechAnimationInterval = setInterval(() => {
        scale += (0.04 + Math.random() * 0.03) * direction;
        if (scale >= 1.25) direction = -1;
        else if (scale <= 0.88) direction = 1;
        cube.setAttribute('scale', `${scale} ${scale} ${scale}`);
      }, 65);
    }

    function stopSpeakingAnimation() {
      if (speechAnimationInterval) {
        clearInterval(speechAnimationInterval);
        speechAnimationInterval = null;
      }
      const cube = document.getElementById('aiCube');
      if (cube) {
        cube.setAttribute('scale', '1 1 1');
      }
    }

    // ==========================================
    // STAR GRAPHICAL DISPLAY LOGIC
    // ============================    // Convert 1-10 numerical score into 1-3 stars
    // ------------------------------------------
    // REPLACED WITH BOOKING STATUS DISPLAY LOGIC
    // ------------------------------------------
    function updateBookingUI(bookingStatus, roomType, roomNumber, guestName, nights) {
      // 1. Update A-Frame 3D Texts in VR
      const status3D = document.getElementById('bookingStatusText');
      const details3D = document.getElementById('roomDetailsText');
      const name3D = document.getElementById('guestNameText');
      const nights3D = document.getElementById('nightsText');
      
      const isCompleted = bookingStatus === "completed";
      
      if (status3D) {
        status3D.setAttribute('value', isCompleted ? "COMPLETED ✓" : "In Progress...");
        status3D.setAttribute('color', isCompleted ? "#4ade80" : "#fbbf24");
      }
      
      if (details3D) {
        let roomText = "Not Selected";
        if (roomType || roomNumber) {
          roomText = `${roomType || 'Standard'} - No. ${roomNumber || 'TBD'}`;
        }
        details3D.setAttribute('value', roomText);
      }
      
      if (name3D) {
        name3D.setAttribute('value', guestName ? `Guest: ${guestName}` : "Guest: TBD");
      }
      if (nights3D) {
        nights3D.setAttribute('value', nights ? `${nights} night(s)` : "Nights: TBD");
      }

      // 2. Update 2D Screen Overlay
      const status2D = document.getElementById('bookingStatus2D');
      const details2D = document.getElementById('roomDetails2D');
      const name2D = document.getElementById('guestName2D');
      const nights2D = document.getElementById('nights2D');

      if (status2D && details2D) {
        status2D.textContent = isCompleted ? "Completed ✓" : "In Progress...";
        status2D.style.color = isCompleted ? "#4ade80" : "#fbbf24";
        
        let roomText2D = "Not Selected";
        if (roomType || roomNumber) {
          roomText2D = `${roomType || 'Standard'} - No. ${roomNumber || 'TBD'}`;
        }
        details2D.textContent = roomText2D;
      }
      if (name2D) {
        name2D.textContent = guestName ? `Guest: ${guestName}` : "Guest: TBD";
      }
      if (nights2D) {
        nights2D.textContent = nights ? `${nights} night(s)` : "Nights: TBD";
      }
    }

    // ==========================================
    // GEMINI CONNECTION & TEXT-TO-SPEECH
    // ==========================================
    async function sendToGemini(textPrompt) {
      try {
        console.log("Calling Gemini API with text:", textPrompt);
        
        // Save user message to memory
        chatHistory.push({
          role: "user",
          parts: [{ text: textPrompt }]
        });
        chatHistory = chatHistory.slice(-20);
        
        // System prompt configures the AI role as a Hotel Receptionist returning JSON
        const systemPrompt = `You are a friendly, professional, and welcoming hotel receptionist in a virtual reality (VR) Hotel.
Speak ONLY in English.
Your goal is to help the user book a room. You MUST ask them for their full name, how many nights they will stay, and their preferred room type (e.g., Single, Double, Suite).
Once you have this information, confirm their booking and assign them a random room number between 101 and 599.
Keep your conversational responses brief (1-3 sentences maximum).

Your response MUST be a JSON object with the following schema:
{
  "receptionistResponse": "Your conversational reply in English, confirming or asking for details.",
  "bookingStatus": "in_progress", // Change to "completed" ONLY when you have all info and have assigned a room number.
  "guestName": null, // The user's name, or null if not yet provided.
  "nights": null, // Number of nights, or null if not yet provided.
  "roomType": null, // The room type chosen, or null if not yet confirmed.
  "roomNumber": null // The assigned room number, or null if not yet assigned.
}

Always output ONLY valid JSON. Speak only in English in the receptionistResponse.`;

        const payload = {
          contents: chatHistory,
          systemInstruction: {
            parts: [{ text: systemPrompt }]
          },
          generationConfig: {
            responseMimeType: "application/json"
          }
        };

        const response = await fetch(ENDPOINT, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(payload)
        });

        if (!response.ok) {
          const errBody = await response.text();
          throw new Error(`API returned status ${response.status}: ${errBody}`);
        }

        const data = await response.json();
        let replyJsonString = "";

        if (data.candidates && data.candidates[0] && data.candidates[0].content && data.candidates[0].content.parts[0]) {
          replyJsonString = data.candidates[0].content.parts[0].text;
          
          // Save model response to memory
          chatHistory.push({
            role: "model",
            parts: [{ text: replyJsonString }]
          });
        } else {
          throw new Error("Invalid API candidates response structure.");
        }

        console.log("Raw Gemini JSON Reply:", replyJsonString);

        // Parse structured data from Gemini
        let aiData;
        try {
          aiData = JSON.parse(replyJsonString);
        } catch (jsonErr) {
          const cleanedString = replyJsonString.replace(/```json|```/g, "").trim();
          try {
            aiData = JSON.parse(cleanedString);
          } catch (jsonErr2) {
            throw new Error("Failed to parse Gemini response as JSON: " + jsonErr2.message);
          }
        }

        const aiReply = aiData.receptionistResponse || "Let me check that for you.";
        const bStatus = aiData.bookingStatus || "in_progress";
        const guestName = aiData.guestName || null;
        const nights = aiData.nights || null;

        // Update UI
        document.getElementById('aiText').setAttribute('value', `Receptionist: ${aiReply}`);
        updateBookingUI(bStatus, aiData.roomType, aiData.roomNumber, guestName, nights);
        
        updateUIState("Speaking...");
        setCubeState("speaking");
        speakText(aiReply);

        // If booking is completed, trigger animation
        if (bStatus === "completed") {
            triggerGoToRoomAnimation();
        }

      } catch (error) {
        console.error("Gemini Request Failed:", error);
        
        // Remove the last user message so they can try again without breaking history
        chatHistory.pop();
        
        const fallbackText = "Sorry, our booking system is currently down. Let's try again.";
        document.getElementById('aiText').setAttribute('value', `AI Error: ${error.message}`);
        updateUIState("HOLD M TO SPEAK");
        setCubeState("idle");
        speakText(fallbackText);
      }
    }

    function triggerGoToRoomAnimation() {
      const cubeEl = document.getElementById('aiCube');
      if (cubeEl) {
        cubeEl.removeAttribute('animation__bob');
        cubeEl.setAttribute('animation__move_room', 'property: position; to: -15 2 -20; dur: 8000; easing: easeInOutQuad');
        cubeEl.addEventListener('animationcomplete', function onMoveDone() {
          cubeEl.removeEventListener('animationcomplete', onMoveDone);
        });
      }
    }

    function speakText(textToSpeak) {
      if (!window.speechSynthesis) return;

      window.speechSynthesis.cancel(); // clear queue

      const utterance = new SpeechSynthesisUtterance(textToSpeak);
      utterance.lang = currentLang;

      // Find compatible voice using preloaded list (Task 3.2 fix)
      const voices = ttsVoiceList.length > 0 ? ttsVoiceList : window.speechSynthesis.getVoices();
      const preferredVoice = voices.find(v => v.lang.startsWith(currentLang.substring(0, 2)) && (v.name.includes('Google') || v.name.includes('Natural'))) ||
    voices.find(v => v.lang.startsWith(currentLang.substring(0, 2))) ||
    voices[0];
      
      if (preferredVoice) {
        utterance.voice = preferredVoice;
      }

      utterance.onend = () => {
        updateUIState("HOLD M TO SPEAK");
        setCubeState("idle");
      };

      utterance.onerror = (err) => {
        console.error("SpeechSynthesis speak Error:", err);
        updateUIState("HOLD M TO SPEAK");
        setCubeState("idle");
      };

      window.speechSynthesis.speak(utterance);
    }

    // Helper alerts
    function showMicWarning(msg) {
      const warningEl = document.getElementById('micWarning');
      if (warningEl) {
        warningEl.innerHTML = `⚠️ <strong>Notice:</strong> ${msg}`;
        warningEl.style.display = 'block';
      }
    }
  </script>
