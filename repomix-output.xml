    // ==========================================
    // GEMINI CONNECTION & TEXT-TO-SPEECH
    // ==========================================
    async function sendToGemini(textPrompt) {
      try {
        console.log("Calling Gemini API with text:", textPrompt);
        
        // Save user message to memory
        chatHistory.push({
          role: "user",
          parts: [{ text: textPrompt }]
        });
        chatHistory = chatHistory.slice(-20);
        
        // System prompt configures the AI role as a hotel GUEST (role reversal)
        const profile = currentGuestProfile;
        const systemPrompt = `You are a hotel guest (the customer) in a virtual reality hotel. The user is the hotel receptionist.

Your profile (internal - do not reveal all at once):
- Name: ${profile.name}
- Number of guests in your party: ${profile.guestsCount}
- Preferred room type (secret until you are offered options): ${profile.secretRoomType}
- Number of nights staying: ${profile.nights}
- Personality: ${profile.personality}

Personality Guidance: ${profile.guidance}

IMPORTANT RULES:
- Speak ONLY in English.
- NEVER include stage directions, asterisks, brackets, or descriptions of physical actions in your speech. Speak only as a real person talking.
- Do NOT reveal your profile information unless the receptionist asks you specific questions.
- If the receptionist asks about room type, ONLY choose from the options they list. If they don't offer options, ask them to describe what is available.
- Keep your conversational responses brief (1-2 sentences maximum).
- Be a realistic guest - behave according to your personality.

Your response MUST be a JSON object with the following schema:
{
  "guestResponse": "Your conversational reply in English as the guest speaking to the receptionist.",
  "detectedMissions": {
    "greeted": false, // SET TO TRUE if the receptionist has greeted or welcomed you
    "nameObtained": false, // SET TO TRUE if the receptionist has asked for or confirmed your name
    "guestsConfirmed": false, // SET TO TRUE if the receptionist has asked how many guests
    "roomTypeSelected": false, // SET TO TRUE if the receptionist has asked about or selected a room type
    "nightsCountAsked": false, // SET TO TRUE if the receptionist has asked how many nights
    "bookingConfirmed": false // SET TO TRUE if the receptionist has confirmed and assigned a room number
  },
  "currentValues": {
    "guestName": null, // Your name, or null if not yet asked
    "guestsCount": null, // Number of guests, or null if not yet asked
    "roomType": null, // Your preferred room type, or null if not yet asked
    "nights": null, // Number of nights, or null if not yet asked
    "roomNumberAssigned": null // Assigned room number (e.g. "Room 204" between 101-599), or null if not yet assigned
  }
}

Always output ONLY valid JSON. Speak only in English in guestResponse.`;

        const payload = {
          contents: chatHistory,
          systemInstruction: {
            parts: [{ text: systemPrompt }]
          },
          generationConfig: {
            responseMimeType: "application/json"
          }
        };

        const response = await fetch(ENDPOINT, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(payload)
        });

        if (!response.ok) {
          const errBody = await response.text();
          throw new Error(`API returned status ${response.status}: ${errBody}`);
        }

        const data = await response.json();
        let replyJsonString = "";

        if (data.candidates && data.candidates[0] && data.candidates[0].content && data.candidates[0].content.parts[0]) {
          replyJsonString = data.candidates[0].content.parts[0].text;
          
          // Save model response to memory
          chatHistory.push({
            role: "model",
            parts: [{ text: replyJsonString }]
          });
        } else {
          throw new Error("Invalid API candidates response structure.");
        }

        console.log("Raw Gemini JSON Reply:", replyJsonString);

        // Parse structured data from Gemini
        let aiData;
        try {
          aiData = JSON.parse(replyJsonString);
        } catch (jsonErr) {
          const cleanedString = replyJsonString.replace(/```json|```/g, "").trim();
          try {
            aiData = JSON.parse(cleanedString);
          } catch (jsonErr2) {
            throw new Error("Failed to parse Gemini response as JSON: " + jsonErr2.message);
          }
        }

        const aiReply = aiData.guestResponse || "Hello, I'd like to check in please.";
        const detectedMissions = aiData.detectedMissions || {};
        const currentValues = aiData.currentValues || {};

        // Update missions and UI
        updateMissionsAndUI(detectedMissions, currentValues);
        
        // Update VR dialogue
        document.getElementById('aiText').setAttribute('value', `Guest: ${aiReply}`);
        document.getElementById('userText').setAttribute('value', `You: ${recognizedText}`);
        
        updateUIState("Speaking...");
        setCubeState("speaking");
        await speakText(aiReply);

        // If booking is confirmed, options for evaluation trigger
        if (currentValues.roomNumberAssigned && detectedMissions.bookingConfirmed === true) {
          triggerGoToRoomAnimation();
          setTimeout(() => {
            if (missions.bookingConfirmed && !evaluationComplete) {
              triggerEvaluation();
            }
          }, 2000);
        }

      } catch (error) {
        console.error("Gemini Request Failed:", error);
        
        // Remove the last user message so they can try again without breaking history
        chatHistory.pop();
        
const fallbackText = "Sorry, our booking system is currently down. Let's try again.";
         document.getElementById('aiText').setAttribute('value', `AI Error: ${error.message}`);
         updateUIState("HOLD M TO SPEAK");
         setCubeState("idle");
         await speakText(fallbackText);
      }
    }

    function triggerGoToRoomAnimation() {
      const cubeEl = document.getElementById('aiNPC');
      if (cubeEl) {
        cubeEl.components['npc-controller'].stopAnimations();
        cubeEl.removeAttribute('npc-controller');
        cubeEl.setAttribute('animation__move_room', 'property: position; to: -15 0 -20; dur: 8000; easing: easeInOutQuad');
        cubeEl.addEventListener('animationcomplete', function onMoveDone() {
          cubeEl.removeEventListener('animationcomplete', onMoveDone);
        });
      }
    }

function getGuestVoiceConfig() {
  if (!currentGuestProfile) {
    return { voiceName: 'en-US-Standard-D', ssmlGender: 'MALE' };
  }
  const name = currentGuestProfile.name;
  if (name === 'Sophia Vance') return { voiceName: 'en-US-Standard-F', ssmlGender: 'FEMALE' };
  if (name === 'David Kim') return { voiceName: 'en-US-Standard-J', ssmlGender: 'MALE' };
  if (name === 'Elena Rostova') return { voiceName: 'en-US-Standard-H', ssmlGender: 'FEMALE' };
  return { voiceName: 'en-US-Standard-D', ssmlGender: 'MALE' };
}

function speakViaAudio(text) {
  return new Promise(async (resolve) => {
    const done = () => {
      updateUIState("HOLD M TO SPEAK");
      setCubeState("idle");
      resolve();
    };

    try {
      const voiceConfig = getGuestVoiceConfig();
      const res = await fetch('/api/synthesize', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          text: text,
          voiceName: voiceConfig.voiceName,
          ssmlGender: voiceConfig.ssmlGender
        })
      });

      if (!res.ok) {
        showTextResponse(text);
        done();
        return;
      }

      const data = await res.json();
      if (!data.audioContent) {
        showTextResponse(text);
        done();
        return;
      }

      if (!ttsAudioCtx || ttsAudioCtx.state === 'closed') {
        ttsAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      if (ttsAudioCtx.state === 'suspended') {
        await ttsAudioCtx.resume();
      }

      const binary = atob(data.audioContent);
      const bytes = new Uint8Array(binary.length);
      for (let i = 0; i < binary.length; i++) {
        bytes[i] = binary.charCodeAt(i);
      }

      const audioBuffer = await ttsAudioCtx.decodeAudioData(bytes.buffer);
      const source = ttsAudioCtx.createBufferSource();
      source.buffer = audioBuffer;
      source.connect(ttsAudioCtx.destination);
      source.onended = done;
      source.start();
    } catch (e) {
      console.warn('Audio TTS play failed:', e);
      showTextResponse(text);
      done();
    }
  });
}

async function speakText(textToSpeak) {
  await speakViaAudio(textToSpeak);
}

