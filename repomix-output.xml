    function loadTtsVoices() {
      if (!window.speechSynthesis) return;
      ttsVoiceList = window.speechSynthesis.getVoices();
      if (ttsVoiceList.length === 0) {
        window.speechSynthesis.onvoiceschanged = () => {
          ttsVoiceList = window.speechSynthesis.getVoices();
        };
      }
    }
