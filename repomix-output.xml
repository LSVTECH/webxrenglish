        }
        
        const now = successAudioCtx.currentTime;
        
        const osc1 = successAudioCtx.createOscillator();
        const gain1 = successAudioCtx.createGain();
        osc1.type = "sine";
        osc1.frequency.setValueAtTime(523.25, now);
        gain1.gain.setValueAtTime(0.12, now);
        gain1.gain.exponentialRampToValueAtTime(0.001, now + 0.15);
        osc1.connect(gain1);
        gain1.connect(successAudioCtx.destination);
        osc1.start(now);
        osc1.stop(now + 0.15);
        
        const osc2 = successAudioCtx.createOscillator();
        const gain2 = successAudioCtx.createGain();
        osc2.type = "sine";
        osc2.frequency.setValueAtTime(659.25, now + 0.08);
        gain2.gain.setValueAtTime(0.12, now + 0.08);
        gain2.gain.exponentialRampToValueAtTime(0.001, now + 0.33);
        osc2.connect(gain2);
        gain2.connect(successAudioCtx.destination);
        osc2.start(now + 0.08);
        osc2.stop(now + 0.33);
      } catch (err) {
        console.warn("Could not play success sound:", err);
      }
    }

let ambientAudioCtx = null;

function initAmbientAudio() {
  if (ambientAudioCtx) return;
  try {
    ambientAudioCtx = new (window.AudioContext || window.webkitAudioContext)();

    const bufferSize = ambientAudioCtx.sampleRate * 2;
    const buffer = ambientAudioCtx.createBuffer(1, bufferSize, ambientAudioCtx.sampleRate);
    const data = buffer.getChannelData(0);
    for (let i = 0; i < bufferSize; i++) {
      data[i] = (Math.random() * 2 - 1) * (1 - Math.random() * 0.5);
    }
    const hvacSource = ambientAudioCtx.createBufferSource();
    hvacSource.buffer = buffer;
    hvacSource.loop = true;
    const hvacFilter = ambientAudioCtx.createBiquadFilter();
    hvacFilter.type = 'lowpass';
    hvacFilter.frequency.setValueAtTime(350, ambientAudioCtx.currentTime);
    hvacFilter.Q.setValueAtTime(0.5, ambientAudioCtx.currentTime);
    const hvacGain = ambientAudioCtx.createGain();
    hvacGain.gain.setValueAtTime(0.012, ambientAudioCtx.currentTime);
    hvacSource.connect(hvacFilter);
    hvacFilter.connect(hvacGain);
    hvacGain.connect(ambientAudioCtx.destination);
    hvacSource.start();

    function scheduleFootstep() {
      if (!ambientAudioCtx) return;
      const delay = 6000 + Math.random() * 12000;
      setTimeout(() => {
        if (!ambientAudioCtx) return;
        const fb = ambientAudioCtx.createBuffer(1, ambientAudioCtx.sampleRate * 0.08, ambientAudioCtx.sampleRate);
        const fd = fb.getChannelData(0);
        for (let i = 0; i < fd.length; i++) {
          fd[i] = (Math.random() * 2 - 1) * (1 - i / fd.length) * 0.025;
        }
        const fs = ambientAudioCtx.createBufferSource();
        fs.buffer = fb;
        const fg = ambientAudioCtx.createGain();
        fg.gain.setValueAtTime(0.006, ambientAudioCtx.currentTime);
        const ff = ambientAudioCtx.createBiquadFilter();
        ff.type = 'lowpass';
        ff.frequency.setValueAtTime(800, ambientAudioCtx.currentTime);
        fs.connect(ff);
        ff.connect(fg);
        fg.connect(ambientAudioCtx.destination);
        fs.start();
        scheduleFootstep();
      }, delay);
    }
    scheduleFootstep();
  } catch (e) {
    console.warn('Ambient audio unavailable:', e);
  }
}

