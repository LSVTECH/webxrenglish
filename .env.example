# ==========================================================================
#  webxrenglish — environment variables template
#  Copy this file to .env.local and fill in the real values.
#  .env.local is gitignored — never commit real secrets.
# ==========================================================================

# --- Application secrets (used by the serverless functions in /api) ---

# Google Generative Language API key (Gemini).
# Used by api/chat.js and api/transcribe.js.
GOOGLE_API_KEY=

# Google Text-to-Speech API key.
# Used by api/synthesize.js. May be the same key as above if it has TTS enabled.
GOOGLE_TTS_API_KEY=

# --- Local development only (NOT used by the application itself) ---

# Port for the local `vercel dev` server (used by dev.sh). Not a secret.
DEV_PORT=49271

# Vercel access token. Only the Vercel CLI uses this, so that `vercel dev`
# can authenticate without an interactive login. Put the real value in
# .env.local (gitignored). Leave this template value empty.
# Alternative: run `vercel login` once instead of using a token.
VERCEL_TOKEN=
