# Google AI Studio API Key (Required for Gemini)
GOOGLE_API_KEY=your_gemini_api_key_here

# Authentication Passcodes
STUDENT_PASSWORD=your_student_access_code
PROFESSOR_PASSWORD=your_professor_access_code

# Vercel KV for Data Storage (Required for Dashboard)
KV_REST_API_URL=your_kv_rest_api_url
KV_REST_API_TOKEN=your_kv_rest_api_token
KV_REST_API_READ_ONLY_TOKEN=your_kv_read_only_token
KV_URL=your_kv_url
